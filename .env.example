# Copy to .env.development.local for local development. Only the database and auth
# secret are needed to run the site and the panel; every other feature switches off
# cleanly when its variables are empty.

# --- Required ---------------------------------------------------------------
# Local: `npm run db:local` serves PGlite on this address
DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres
# Direct (non-pooled) connection for migrations; falls back to DATABASE_URL
DATABASE_URL_UNPOOLED=
# Any long random string, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Staff panel sign-in (Google OAuth) ---------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated; these accounts start as approved admins
ADMIN_EMAILS=

# --- Notifications ----------------------------------------------------------
# Web Push keys: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
RESEND_API_KEY=
# Where new booking requests are emailed
RESERVATION_EMAIL=
# Sender on a domain verified in Resend; enables guest receipt emails
RESEND_FROM=

# --- Airbnb calendar import (iCal export link per room) -----------------------
AIRBNB_ICAL_AMBAR1=
AIRBNB_ICAL_AMBAR2=
AIRBNB_ICAL_AMBAR3=
AIRBNB_ICAL_KULUBE1=
AIRBNB_ICAL_KULUBE2=
AIRBNB_ICAL_TINY=

# --- Google rating and reviews (Places API (New)) ----------------------------
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Operations -------------------------------------------------------------
# Bearer token for /api/cron (Vercel Cron and GitHub Actions send it)
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" only in production, so previews and local builds stay out of search engines
SITE_INDEXABLE=
